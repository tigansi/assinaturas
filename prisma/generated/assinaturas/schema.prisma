generator client {
  provider = "prisma-client-js"
  output   = "./generated/assinaturas"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_ASSINATURAS")
}

model admins {
  id            Int     @id @default(autoincrement()) @db.UnsignedInt
  nome_admin    String  @db.VarChar(255)
  usuario_admin String  @db.VarChar(50)
  is_ativo      Boolean @default(true)
}

model organizacao {
  id                   Int                    @id @default(autoincrement()) @db.UnsignedInt
  nome_organizacao     String                 @db.VarChar(255)
  usuario_criacao      String                 @db.VarChar(50)
  is_ativo             Boolean                @default(true)
  chaves_api           chaves_api[]
  usuarios_organizacao usuarios_organizacao[]
}

model usuarios_organizacao {
  id             Int         @id @default(autoincrement()) @db.UnsignedInt
  id_usuario     usuarios    @relation(fields: [usuarios_id], references: [id])
  id_organizacao organizacao @relation(fields: [organizacao_id], references: [id])
  organizacao_id Int         @db.UnsignedInt
  usuarios_id    Int         @db.UnsignedInt
}

model chaves_api {
  id             Int         @id @default(autoincrement()) @db.UnsignedInt
  chave_api      String      @unique @db.VarChar(100)
  id_organizacao organizacao @relation(fields: [organizacao_id], references: [id])
  is_ativo       Boolean     @default(true)
  organizacao_id Int         @db.UnsignedInt
}

model usuarios {
  id                   Int                    @id @default(autoincrement()) @db.UnsignedInt
  nome                 String                 @db.VarChar(255)
  email                String                 @unique @db.VarChar(255)
  nascimento           DateTime               @db.Date
  senha                String                 @db.VarChar(200)
  token                String                 @unique(map: "acesso_token_unique") @db.VarChar(50)
  created_at           DateTime               @default(now()) @db.Timestamp(0)
  updated_at           DateTime               @default(now()) @db.Timestamp(0)
  tipo_acesso          String                 @db.VarChar(10)
  is_ativo             Boolean                @default(true)
  jwt_token            jwt_token[]
  templates            templates[]
  usuarios_organizacao usuarios_organizacao[]
  documentos           documentos[]
}

model jwt_token {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  jwt_token   String   @db.LongText()
  id_usuario  usuarios @relation(fields: [usuarios_id], references: [id])
  usuarios_id Int      @db.UnsignedInt
}

model templates {
  id                 Int                  @id @default(autoincrement()) @db.UnsignedInt
  nome_template      String               @db.VarChar(255)
  diretorio_arquivo  String               @db.VarChar(150)
  token_template     String               @unique @db.VarChar(50)
  created_at         DateTime             @default(now()) @db.Timestamp(0)
  is_ativo           Boolean              @default(true)
  id_usuario         usuarios             @relation(fields: [usuarios_id], references: [id])
  usuarios_id        Int                  @db.UnsignedInt
  variaveis_template variaveis_template[]
  documentos         documentos[]
}

model variaveis_template {
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  nome_variavel String    @db.VarChar(255)
  id_template   templates @relation(fields: [templates_id], references: [id])
  templates_id  Int       @db.UnsignedInt
}

model documentos {
  id                    Int                     @id @default(autoincrement()) @db.UnsignedInt
  usuarios              usuarios                @relation(fields: [usuariosId], references: [id])
  templates             templates               @relation(fields: [templatesId], references: [id])
  usuariosId            Int                     @db.UnsignedInt
  templatesId           Int                     @db.UnsignedInt
  created_at            DateTime                @default(now()) @db.Timestamp(0)
  token_doc             String                  @unique @db.VarChar(50)
  is_ativo              Boolean                 @default(true)
  assinantes_documentos assinantes_documentos[]
  dados_assinantes      dados_assinantes[]
  status_documentos     status_documentos[]
}

model assinantes_documentos {
  id              Int        @id @default(autoincrement()) @db.UnsignedInt
  nome_assinante  String     @db.VarChar(255)
  email_assinante String     @db.VarChar(255)
  documentos      documentos @relation(fields: [documentosId], references: [id])
  documentosId    Int        @db.UnsignedInt
}

model dados_assinantes {
  id                    Int        @id @default(autoincrement()) @db.UnsignedInt
  ip_assinante          String     @db.VarChar(50)
  localizacao_assinante String     @db.VarChar(100)
  documento             documentos @relation(fields: [documentosId], references: [id])
  documentosId          Int        @db.UnsignedInt
}

model status_documentos {
  id               Int        @id @default(autoincrement()) @db.UnsignedInt
  status_documento Int
  documentos       documentos @relation(fields: [documentosId], references: [id])
  documentosId     Int        @db.UnsignedInt
}
