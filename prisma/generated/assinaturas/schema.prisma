generator client {
  provider = "prisma-client-js"
  output   = "./generated/assinaturas"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_ASSINATURAS")
}

model admins {
  id            Int     @id @default(autoincrement()) @db.UnsignedInt
  nome_admin    String  @db.VarChar(300)
  usuario_admin String  @db.VarChar(50)
  is_ativo      Boolean @default(true)
}

model organizacao {
  id                   Int                    @id @default(autoincrement()) @db.UnsignedInt
  nome_organizacao     String                 @db.VarChar(300)
  usuario_criacao      String                 @db.VarChar(50)
  is_ativo             Boolean                @default(true)
  chaves_api           chaves_api[]
  usuarios_organizacao usuarios_organizacao[]
}

model usuarios_organizacao {
  id             Int         @id @default(autoincrement()) @db.UnsignedInt
  id_usuario     usuarios    @relation(fields: [usuarios_id], references: [id])
  id_organizacao organizacao @relation(fields: [organizacao_id], references: [id])
  organizacao_id Int         @db.UnsignedInt
  usuarios_id    Int         @db.UnsignedInt
}

model chaves_api {
  id             Int         @id @default(autoincrement()) @db.UnsignedInt
  chave_api      String      @unique @db.VarChar(100)
  id_organizacao organizacao @relation(fields: [organizacao_id], references: [id])
  is_ativo       Boolean     @default(true)
  organizacao_id Int         @db.UnsignedInt
}

model usuarios {
  id                   Int                    @id @default(autoincrement()) @db.UnsignedInt
  nome                 String                 @db.VarChar(300)
  email                String                 @unique @db.VarChar(300)
  nascimento           DateTime               @db.Date
  senha                String                 @db.VarChar(200)
  token                String                 @unique(map: "acesso_token_unique") @db.VarChar(50)
  created_at           DateTime               @default(now()) @db.Timestamp(0)
  updated_at           DateTime               @default(now()) @db.Timestamp(0)
  tipo_acesso          String                 @db.VarChar(10)
  is_ativo             Boolean                @default(true)
  jwt_token            jwt_token[]
  templates            templates[]
  usuarios_organizacao usuarios_organizacao[]
}

model jwt_token {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  jwt_token   String   @db.LongText()
  id_usuario  usuarios @relation(fields: [usuarios_id], references: [id])
  usuarios_id Int      @db.UnsignedInt
}

model templates {
  id                 Int                  @id @default(autoincrement()) @db.UnsignedInt
  nome_template      String               @db.VarChar(255)
  diretorio_arquivo  String               @db.VarChar(150)
  token_template     String               @db.VarChar(50)
  created_at         DateTime             @default(now()) @db.Timestamp(0)
  is_ativo           Boolean              @default(true)
  id_usuario         usuarios             @relation(fields: [usuarios_id], references: [id])
  usuarios_id        Int                  @db.UnsignedInt
  variaveis_template variaveis_template[]
}

model variaveis_template {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  id_template  templates @relation(fields: [templates_id], references: [id])
  templates_id Int       @db.UnsignedInt
}

model status_documentos {
  id               Int @id @default(autoincrement()) @db.UnsignedInt
  status_documento Int
}
