generator client {
  provider = "prisma-client-js"
  output   = "./generated/assinaturas"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_ASSINATURAS")
}

model Admins {
  id            Int     @id @default(autoincrement()) @db.UnsignedInt
  nome_admin    String  @db.VarChar(300)
  usuario_admin String  @db.VarChar(50)
  is_ativo      Boolean @default(true)
}

model Organizacao {
  id                  Int                   @id @default(autoincrement()) @db.UnsignedInt
  nome_organizacao    String                @db.VarChar(300)
  usuario_criacao     String                @db.VarChar(50)
  is_ativo            Boolean               @default(true)
  ChavesApi           ChavesApi[]
  UsuariosOrganizacao UsuariosOrganizacao[]
}

model UsuariosOrganizacao {
  id             Int         @id @default(autoincrement()) @db.UnsignedInt
  id_usuario     Usuarios    @relation(fields: [usuariosId], references: [id])
  id_organizacao Organizacao @relation(fields: [organizacaoId], references: [id])
  organizacaoId  Int         @db.UnsignedInt
  usuariosId     Int         @db.UnsignedInt
}

model ChavesApi {
  id             Int         @id @default(autoincrement()) @db.UnsignedInt
  chave_api      String      @unique @db.VarChar(100)
  id_organizacao Organizacao @relation(fields: [organizacaoId], references: [id])
  is_ativo       Boolean     @default(true)
  organizacaoId  Int         @db.UnsignedInt
  Usuarios       Usuarios?   @relation(fields: [usuariosId], references: [id])
  usuariosId     Int?        @db.UnsignedInt
}

model Usuarios {
  id                  Int                   @id @default(autoincrement()) @db.UnsignedInt
  nome                String                @db.VarChar(300)
  email               String                @unique @db.VarChar(300)
  nascimento          DateTime              @db.Date
  senha               String                @db.VarChar(200)
  token               String                @unique(map: "acesso_token_unique") @db.VarChar(50)
  created_at          DateTime              @default(now()) @db.Timestamp(0)
  updated_at          DateTime              @default(now()) @db.Timestamp(0)
  tipo_acesso         String                @db.VarChar(10)
  is_ativo            Boolean               @default(true)
  ChavesApi           ChavesApi[]
  JwtToken            JwtToken[]
  Templates           Templates[]
  UsuariosOrganizacao UsuariosOrganizacao[]
}

model JwtToken {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  jwt_token  String   @db.LongText()
  id_usuario Usuarios @relation(fields: [usuariosId], references: [id])
  usuariosId Int      @db.UnsignedInt
}

model Templates {
  id                Int                 @id @default(autoincrement()) @db.UnsignedInt
  nome_template     String              @db.VarChar(255)
  diretorio_arquivo String              @db.VarChar(150)
  token_template    String              @db.VarChar(50)
  created_at        DateTime            @default(now()) @db.Timestamp(0)
  is_ativo          Boolean             @default(true)
  id_usuario        Usuarios            @relation(fields: [usuariosId], references: [id])
  usuariosId        Int                 @db.UnsignedInt
  VariaveisTemplate VariaveisTemplate[]
}

model VariaveisTemplate {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  id_template Templates @relation(fields: [templatesId], references: [id])
  templatesId Int       @db.UnsignedInt
}

/**
 * model Documentos {
 * id                   Int      @id @default(autoincrement()) @db.UnsignedInt
 * nome_arquivo         String   @db.VarChar(255)
 * token_arquivo        String   @unique @db.VarChar(50)
 * diretorio_arquivo    String   @db.VarChar(150)
 * is_ativo             Boolean? @default(true)
 * created_at           DateTime @default(now()) @db.Timestamp(0)
 * updated_at           DateTime @default(now()) @db.Timestamp(0)
 * token_usuario_logado String   @db.VarChar(50)
 * id_usuarios          Usuarios @relation(fields: [usuariosId], references: [id])
 * usuariosId           Int      @db.UnsignedInt
 * }
 */

model StatusDocumentos {
  id               Int @id @default(autoincrement()) @db.UnsignedInt
  status_documento Int
}
